
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return userRole() == "ADMIN" || userRole() == "admin";
    }

    function isDirector() {
      return userRole() == "DIRECTOR" || userRole() == "director";
    }

    function isCast() {
      return isCastRole(userRole());
    }

    function isCastRole(role) {
      return role == "CAST_MEMBER" ||
        role == "cast_member" ||
        role == "CAST" ||
        role == "cast";
    }

    match /users/{uid} {
      allow read: if signedIn() &&
        (request.auth.uid == uid || isAdmin());

      // Public registration may create only its own explicitly-cast profile.
      // Administrators may provision other users through this trusted path.
      allow create: if
        (signedIn() &&
         request.auth.uid == uid &&
         isCastRole(request.resource.data.role)) ||
        (isAdmin() && request.auth.uid != uid);

      allow update: if
        (request.auth.uid == uid &&
         request.resource.data.role == resource.data.role) ||
        (isAdmin() && request.auth.uid != uid);

      allow delete: if isAdmin();
    }

    match /productions/{productionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || isDirector();
    }

    match /auditions/{auditionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || isDirector();
    }

    match /applications/{applicationId} {
      allow read: if signedIn();
      allow create: if isCast();
      allow update, delete: if isAdmin() || isDirector();
    }

    match /roles/{roleId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || isDirector();
    }

    match /castAssignments/{assignmentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || isDirector();
    }

    match /rehearsals/{rehearsalId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || isDirector();
    }

    match /venues/{venueId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() &&
        resource.data.userId == request.auth.uid;

      allow update: if signedIn() &&
        resource.data.userId == request.auth.uid;

      allow create: if isAdmin() || isDirector();
      allow delete: if isAdmin();
    }
  }
}
